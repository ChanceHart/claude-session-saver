{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/save_session.py\" hook",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  },
  "env": {
    "SESSION_SAVER_DIR": "Journal/Sessions/Transcripts"
  }
}
